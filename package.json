{
  "name": "opencanvas",
  "version": "0.2.0",
  "private": true,
  "description": "OpenCanvas desktop app",
  "main": "electron/main.cjs",
  "author": "OpenCanvas",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently -k -s first \"vite --host 127.0.0.1 --port 5173\" \"wait-on http://127.0.0.1:5173 && electron . --dev\"",
    "build": "vite build",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder --win portable",
    "dist:dir": "npm run build && electron-builder --win dir",
    "typecheck": "tsc --noEmit",
    "update:desktop": "npm run build && electron-builder --win dir --config.directories.output=release-install && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/update-desktop.ps1"
  },
  "dependencies": {
    "ag-psd": "^34.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "concurrently": "^9.2.1",
    "electron": "^38.0.0",
    "electron-builder": "^26.0.12",
    "typescript": "^5.9.0",
    "vite": "^7.2.0",
    "wait-on": "^8.0.4"
  },
  "build": {
    "appId": "com.opencanvas.desktop",
    "productName": "OpenCanvas",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "dist/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "icon": "electron/assets/icon.ico",
      "target": [
        "portable"
      ],
      "artifactName": "OpenCanvas-Setup-${version}.exe"
    },
    "portable": {
      "artifactName": "OpenCanvas-${version}.exe"
    }
  }
}
